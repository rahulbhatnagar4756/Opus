<Application x:Class="OpusOneEmulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Default Light Theme -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#FF2C3E50"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#FF34495E"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#FFF5F5F5"/>
        <SolidColorBrush x:Key="TextBrush" Color="White"/>
        <SolidColorBrush x:Key="MainTextBrush" Color="Black"/>
    </Application.Resources>
</Application>
