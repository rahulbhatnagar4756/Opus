<Window x:Class="OpusOneEmulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpusOneEmulator.Controls"
        Title="Opus One Organizer - Windows 11 Pro"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <StackPanel Background="{DynamicResource SidebarBackground}" Grid.Column="0">
            <TextBlock FontWeight="Bold"
                       FontSize="24"
                       Margin="16,20,16,30"
                       Foreground="{DynamicResource TextBrush}"
                       Text="Opus One"
                       HorizontalAlignment="Center"/>

            <Button Content="Daily"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="DailyButton_Click"/>

            <Button Content="Weekly"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="WeeklyButton_Click"/>

            <Button Content="Monthly"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="MonthlyButton_Click"/>

            <Button Content="Tasks"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="TasksButton_Click"/>

            <Button Content="Notes"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="NotesButton_Click"/>

            <Button Content="Goals"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="GoalsButton_Click"/>

            <Button Content="Weather"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="WeatherButton_Click"/>

            <Button Content="Meetings"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="MeetingsButton_Click"/>

            <Button Content="Settings"
                    Margin="12,6" Padding="10"
                    FontSize="14"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource TextBrush}"
                    BorderThickness="0"
                    Click="SettingsButton_Click"/>
        </StackPanel>

        <!-- Main Content Area -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"
                        Background="{DynamicResource WindowBackground}"/>
    </Grid>
</Window>
